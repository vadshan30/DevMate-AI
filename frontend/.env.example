# Firebase Web App configuration
# Copy this file to .env and fill in the real values from the Firebase Console.
# .env is gitignored; .env.example must never contain real credentials.
#
# Firebase web config is NOT a server secret — it identifies the project
# to the Firebase client SDK and is safe to embed in the browser bundle.
# Never put the Gemini API key or Firebase Admin service-account key here.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# DevMate AI backend (Express + Gemini).
# Use the same origin in production behind a reverse proxy, or the full
# Cloud Run URL. Default targets the local Node backend on port 5000.
VITE_API_URL=http://localhost:5000
