# Server
PORT=5000
NODE_ENV=development

# Gemini API
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS — comma-separated list of allowed origins
# Example: http://localhost:5173,https://devmate-ai.example.com
CORS_ORIGIN=http://localhost:5173

# Firebase Admin (service account)
# Values are read from environment variables; never commit the real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# IMPORTANT: wrap the private key in double quotes and replace \n with literal newlines,
# or paste the full PEM block on a single line with \n escape sequences preserved.
FIREBASE_PRIVATE_KEY=
